# .env.example → .env 로 복사해서 쓰세요. 비워 둔 항목은 기본값.

# ── 번역 LLM ─────────────────────────────────────────────
# ollama: Ollama API (Ollama Cloud 또는 로컬 Ollama)   openai: OpenAI 호환 API 전반(OpenAI, Gemini, OpenRouter, vLLM, LM Studio …)
MT_LLM_API=ollama
# ollama 기본 https://ollama.com (로컬이면 http://localhost:11434) / openai 기본 https://api.openai.com/v1
#   예) Gemini: https://generativelanguage.googleapis.com/v1beta/openai   OpenRouter: https://openrouter.ai/api/v1
MT_LLM_URL=
MT_LLM_KEY=
# 이미지 입력을 지원하는 모델이어야 함 (기본 gemma4:31b)
MT_LLM_MODEL=gemma4:31b
# 번역 동시 요청 수
MT_LLM_WORKERS=3
# Ollama 컨텍스트 길이(로컬 Ollama에서 VRAM이 모자라면 줄이세요)
MT_LLM_CTX=32768

# ── 그림 위 글자 지우기 ──────────────────────────────────
# lama(기본, 처음 쓸 때 ~200MB 자동 다운로드) | opencv(모델 없음, 품질 낮음) | moss(ComfyUI + MOSS-Image, VRAM ~26GB)
MT_INPAINT=lama
# moss일 때: ComfyUI 주소, 그리고 꺼져 있으면 자동으로 띄울 ComfyUI 폴더(선택)
MT_COMFY_URL=http://127.0.0.1:8188
MT_COMFY_DIR=
MT_COMFY_PYTHON=
# moss로 ComfyUI를 띄우기 직전에 실행할 명령(선택). 예: 다른 GPU 프로그램 끄기
MT_BEFORE_GPU=
# moss일 때 ComfyUI 안의 모델 이름 (ComfyUI-MOSS-Toolkit의 MOSS-Image Loader 기준)
MT_MOSS_DIT=MOSS-Image-Base
MT_MOSS_TE=int8/qwen35_9b_int8_convrot.safetensors
MT_MOSS_VAE=MOSS-Image-Base
MT_MOSS_LORA=moss_i2i_sanitize_v3.safetensors

# ── 글꼴 (비우면 fonts/ 안의 기본 글꼴) ───────────────────
MT_FONT_DIALOGUE=
MT_FONT_SHOUT=
MT_FONT_HAND=
MT_FONT_FALLBACK=

# ── 웹 UI ────────────────────────────────────────────────
# 다른 기기에서 접속하려면 0.0.0.0 (인증이 없으니 믿을 수 있는 네트워크에서만)
MT_HOST=127.0.0.1
MT_PORT=8196
